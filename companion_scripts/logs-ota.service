# =============================================================================
# Quiver Hub — Logs & OTA Service (systemd unit TEMPLATE)
# =============================================================================
# Render this template with its installer. It must not be copied directly.
# Required renderer placeholders: INSTALL_DIR_PLACEHOLDER, SERVICE_USER_PLACEHOLDER,
# SERVICE_GROUP_PLACEHOLDER, ENV_FILE_PLACEHOLDER, ENV_ASSIGNMENT_PLACEHOLDER.
#
# This template intentionally does not set User=/Group=. The existing Logs & OTA
# installer owns that privilege decision; leaving the directives commented keeps
# its current root behavior unchanged while exposing the portable placeholders.
# User=SERVICE_USER_PLACEHOLDER
# Group=SERVICE_GROUP_PLACEHOLDER

[Unit]
Description=Quiver Hub — Logs & OTA Service
Documentation=https://github.com/Pan-Robotics/Arrow-Quiver-Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=INSTALL_DIR_PLACEHOLDER
EnvironmentFile=ENV_FILE_PLACEHOLDER
Environment=ENV_ASSIGNMENT_PLACEHOLDER
Environment=PYTHONUNBUFFERED=1
# logs_ota_service.py loads deployment settings from the shared .env at runtime.
# Keep ExecStart free of Hub credentials, URLs, and FC network values.
ExecStart=/usr/bin/python3 LOGS_OTA_SCRIPT_PLACEHOLDER
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=logs-ota
ProtectSystem=strict
ReadWritePaths=/tmp INSTALL_DIR_PLACEHOLDER /var/lib/quiver/fc_logs
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
