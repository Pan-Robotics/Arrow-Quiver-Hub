# Illustrative TEMPLATE; install_hub_client.sh generates the authoritative unit.
# Do not install this source template directly.
# Required renderer placeholders: INSTALL_DIR_PLACEHOLDER, SERVICE_USER_PLACEHOLDER,
# SERVICE_GROUP_PLACEHOLDER, ENV_FILE_PLACEHOLDER, ENV_ASSIGNMENT_PLACEHOLDER.
# WORKING_DIRECTORY_PLACEHOLDER is a literal path, not a quoted argument.
[Unit]
Description=Quiver Hub Client — Two-way Hub communication
Documentation=https://github.com/Pan-Robotics/Arrow-Quiver-Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=SERVICE_USER_PLACEHOLDER
Group=SERVICE_GROUP_PLACEHOLDER
WorkingDirectory=WORKING_DIRECTORY_PLACEHOLDER
EnvironmentFile=ENV_FILE_PLACEHOLDER
Environment=ENV_ASSIGNMENT_PLACEHOLDER
Environment=PYTHONUNBUFFERED=1
# Python reads HUB_URL/WEB_SERVER_URL, DRONE_ID, API_KEY, and POLL_INTERVAL.
ExecStart=/usr/bin/python3 HUB_CLIENT_SCRIPT_PLACEHOLDER
Restart=always
RestartSec=10
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=quiver-hub-client
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# The generated unit grants only dedicated CONFIG_DIR/PARSERS_DIR data roots.

[Install]
WantedBy=multi-user.target
