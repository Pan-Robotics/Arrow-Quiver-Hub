[Unit]
Description=Quiver Camera Stream Manager (go2rtc + Tailscale Funnel + Hub Registration)
After=network-online.target go2rtc.service tailscale-funnel.service
Wants=network-online.target
Requires=go2rtc.service

[Service]
Type=simple
User=SERVICE_USER_PLACEHOLDER
Group=SERVICE_GROUP_PLACEHOLDER
WorkingDirectory=WORKING_DIRECTORY_PLACEHOLDER
EnvironmentFile=ENV_FILE_PLACEHOLDER
Environment=ENV_ASSIGNMENT_PLACEHOLDER
Environment=PYTHONUNBUFFERED=1
# Runtime configuration is loaded from the shared .env; no Hub URL, API key,
# camera address, or go2rtc endpoint is pinned into this unit.
ExecStart=/usr/bin/python3 CAMERA_STREAM_SCRIPT_PLACEHOLDER
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=camera-stream

[Install]
WantedBy=multi-user.target
