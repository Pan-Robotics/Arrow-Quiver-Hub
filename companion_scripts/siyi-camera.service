# WORKING_DIRECTORY_PLACEHOLDER is a literal path, not a quoted argument.
[Unit]
Description=Quiver SIYI A8 Mini Camera Controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=SERVICE_USER_PLACEHOLDER
Group=SERVICE_GROUP_PLACEHOLDER
WorkingDirectory=WORKING_DIRECTORY_PLACEHOLDER
EnvironmentFile=ENV_FILE_PLACEHOLDER
Environment=ENV_ASSIGNMENT_PLACEHOLDER
Environment=PYTHONUNBUFFERED=1
# Runtime configuration is loaded from the shared .env; this unit deliberately
# contains no Hub URL, API key, or camera network address.
ExecStart=/usr/bin/python3 SIYI_CONTROLLER_SCRIPT_PLACEHOLDER
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=siyi-camera

[Install]
WantedBy=multi-user.target
