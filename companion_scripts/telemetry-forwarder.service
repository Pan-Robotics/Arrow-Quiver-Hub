# Illustrative TEMPLATE; install_telemetry_forwarder.sh generates the authoritative unit.
# Do not install this source template directly.
# Required renderer placeholders: INSTALL_DIR_PLACEHOLDER, SERVICE_USER_PLACEHOLDER,
# SERVICE_GROUP_PLACEHOLDER, ENV_FILE_PLACEHOLDER, ENV_ASSIGNMENT_PLACEHOLDER.
# WORKING_DIRECTORY_PLACEHOLDER is a literal path, not a quoted argument.
[Unit]
Description=Quiver Hub Telemetry Forwarder (MAVLink + UAVCAN to Hub)
Documentation=https://github.com/Pan-Robotics/Arrow-Quiver-Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=SERVICE_USER_PLACEHOLDER
Group=SERVICE_GROUP_PLACEHOLDER
WorkingDirectory=WORKING_DIRECTORY_PLACEHOLDER
EnvironmentFile=ENV_FILE_PLACEHOLDER
Environment=ENV_ASSIGNMENT_PLACEHOLDER
Environment=PYTHONUNBUFFERED=1
# telemetry_forwarder.py reads all network and telemetry settings from the
# service environment populated by the shared .env.
ExecStart=/usr/bin/python3 TELEMETRY_FORWARDER_SCRIPT_PLACEHOLDER
Restart=always
RestartSec=10
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=telemetry-forwarder
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# The installer generates the actual writable-data policy; code stays installer-owned.

[Install]
WantedBy=multi-user.target
