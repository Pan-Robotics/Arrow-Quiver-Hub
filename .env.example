# Quiver Hub — local configuration
#
# Every value here is OPTIONAL. With no .env file at all, the Hub runs as a
# self-contained local app: SQLite at ./data/quiver.db, file storage under
# ./data/storage, on http://localhost:3000. Copy this file to ".env" only if
# you need to override a default.

# Port the Hub listens on (default: 3000; auto-bumps if busy).
PORT=3000

# Bind address (default: 0.0.0.0 = every interface, so companion computers on
# the drone subnet / LAN / tailnet can reach the Hub). The operator UI has no
# login, so anyone who can reach this port is the operator: keep it on a trusted
# network, or set 127.0.0.1 and reach it through an authenticated tunnel.
# HOST=0.0.0.0

# SQLite database file. A bare path, or a "file:" / "sqlite:" URL.
# Default: ./data/quiver.db (created automatically on first run).
# DATABASE_URL=./data/quiver.db

# Directory for uploaded files (flight logs, firmware, drone files, media).
# Default: ./data/storage (created automatically).
# STORAGE_DIR=./data/storage

# Absolute base URL the Hub is reachable at FROM COMPANION COMPUTERS (drones).
# Used to build absolute file URLs embedded in companion jobs (firmware flash,
# file delivery) so the Raspberry Pi can fetch them over the network.
# Leave unset for single-machine use (the browser's own host is used). Set it
# when the drone reaches the Hub by a different address than the browser does,
# e.g. the laptop's address on the Quiver drone subnet, or its Tailscale address.
# PUBLIC_BASE_URL=http://192.168.144.200:3000
# PUBLIC_BASE_URL=https://quiver-hub-op1.<tailnet>.ts.net   # via tailscale serve (infra/tailscale/)

# Identity this Hub presents when it takes the control lease of a pull-mode
# drone (default: hub-<hostname>). Make it unique per operator laptop.
# HUB_ID=hub-op1
